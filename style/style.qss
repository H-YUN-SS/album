
MainWindow {
    background-color:#f7f9fb;
}

/*菜单栏基本样式*/
QMenuBar{
    color:#2c3e50;
    background-color:#ffffff;
}

/*菜单下拉面板*/
QMenu{
    color:#2c3e50;
    background-color:#ffffff;
}

/* 菜单栏hover选中 */
QMenuBar::item:selected {
        background-color:#e8f0f7;
}

/*下拉菜单条目选中高亮 雾霾ins蓝*/
QMenu::item:selected {
    background-color:#d0e1f2;
    color:#2c3e50;
}


ProTree {
    border-color: #d0d7e0;
    border-style: solid;
    border-width: 1px;
    padding-right: 10px;
}

QLabel#label_pro {
    color:#445566;
    border-color: #cad4e0;
    border-style: dotted;
    border-width: 0 0 1px 0;
    padding-bottom: 10px;
    margin-bottom: 5px;
}

PicShow {
    border-color: #d0d7e0;
    border-style: solid;
    border-width: 1px;
    padding: 10px;
    background: #ffffff;
}

QWizard {
    color:#2c3e50;
    background-color:#f7f9fb;
}

QWizard QLabel#tips {
    color: #e74c3c;
}

QTreeView {
    color:#2c3e50;
    background-color:#ffffff;
    border: 0px;
}

QTreeView::item:hover {
    background: #e8f0f7;
}

QTreeView::item:selected {
    background: #d0e1f2;
    color:#2c3e50;
}

/*活动项目加粗*/
#TreeProActiveItem {
    font-weight:bold;
}

/*树展开折叠箭头图标，保留你原有资源*/
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings
{image: url(:/icon/down.png);}

QTreeView::branch:closed:has-children:!has-siblings,
QTreeView::branch:closed:has-children:has-siblings
{image: url(:/icon/right.png);}

#nextBtn,#closeBtn,#previousBtn  {
    border: 0px;
}

SlideShowDlg {
    color:#2c3e50;
    background-color:#f7f9fb;
}

#preListWidget {
    color:#2c3e50;
    background-color:#ffffff;
    border: 0px;
}

#preListWidget::item:hover {
    background: #e8f0f7;
}

#preListWidget::item:selected {
    background: #d0e1f2;
    color:#2c3e50;
}

#slidpreBtn,#slidenextBtn,#playBtn {
    border: 0px;
}

#slideprewid {
    margin-left:10px;
}

#slidenextwid{
    margin-right:10px;
}

#preListWidget::item:selected:active{
    border: 2px solid #8fb8dd;
}

#preListWidget::item:selected{
    border: 2px solid #8fb8dd;
}